# Copy this file to `.env` and set the values for your own machine.
# `.env` is gitignored, so nothing here ever reaches a commit.
#
# Real environment variables take priority over this file, so a one-off
# override still works:  $env:SAFETYNET_SQL_SERVER="OTHER"; python -m ...

# --- Which SQL Server to talk to -------------------------------------------
#
# Find yours:
#   (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Microsoft SQL Server').InstalledInstances
#
# MSSQLSERVER means a DEFAULT instance -> use the bare machine name:
#   SAFETYNET_SQL_SERVER=XUSHOE
# Anything else is a NAMED instance -> prefix with .\
#   SAFETYNET_SQL_SERVER=.\SQLEXPRESS
#
# Getting this wrong shows up as ODBC error 08001, "Error Locating
# Server/Instance Specified".
SAFETYNET_SQL_SERVER=.\SQLEXPRESS

# --- Which databases ---------------------------------------------------------
#
# The canonical `core` layer. Has been called both SafetyNet and SafetyNetQA
# on different machines. Error 28000 ("Login failed") usually means the server
# is fine but this database does not exist -- check the name here first, then
# run `python -m scripts.build_safetynet_db` to create it.
SAFETYNET_SQL_DATABASE=SafetyNetQA

# The Synthea-derived warehouse the SafetyHops cohort reads from.
SAFETYHOPS_SQL_DATABASE=SafetyHops

# --- Driver ------------------------------------------------------------------
# Only change this if `odbcad32.exe` shows a different version installed.
SAFETYNET_SQL_DRIVER=ODBC Driver 17 for SQL Server
